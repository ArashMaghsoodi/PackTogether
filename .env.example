TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Local runtime database (primary source of truth)
DATABASE_PATH=packtogether.sqlite3

# Optional Supabase mirror (async background sync)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional Telegram developer sync logs
DEV_ID=123456789
SYNC_LOG_LEVEL=normal
SYNC_LOG_VERBOSE=false

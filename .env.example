TELEGRAM_BOT_TOKEN=replace-with-botfather-token
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional: direct Postgres DSN (alternative to URL+service-role)
SUPABASE_DB_URL=postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres
# Optional fallback for local SQLite when neither Supabase mode is configured
DATABASE_PATH=packtogether.sqlite3
